---
import BaseLayout from '../../layouts/BaseLayout.astro'

const archDiagram = `┌──────────────────┐     ┌───────────────────────┐     ┌──────────┐
│  Vue 3 + Vite     │────▶│  Django REST Framework │────▶│  MySQL    │
│  + Element Plus   │     │  + JWT 认证             │     │  数据库   │
│  + Three.js       │     └───────────────────────┘     └──────────┘
└──────────────────┘                │
                          ┌─────────┴─────────┐
                          │                   │
                    ┌─────┴─────┐     ┌──────┴──────┐
                    │  DeepSeek  │     │  知识图谱    │
                    │  AI 引擎   │     │  推荐系统    │
                    └───────────┘     └─────────────┘`

const codeSample = `# Django REST Framework — 智能路线规划 API
# serializers.py
class RoutePlanSerializer(serializers.ModelSerializer):
    spots = ScenicSpotSerializer(many=True, read_only=True)
    
    class Meta:
        model = RoutePlan
        fields = ['id', 'name', 'days', 'spots', 'preferences', 'created_at']

# views.py  
class RoutePlanViewSet(viewsets.ModelViewSet):
    serializer_class = RoutePlanSerializer
    permission_classes = [IsAuthenticated]
    
    def perform_create(self, serializer):
        # AI 智能生成路线
        preferences = self.request.data.get('preferences', {})
        spots = ScenicSpot.objects.filter(
            category__in=preferences.get('interests', [])
        )
        ai_route = ai_service.generate_route(
            spots=list(spots.values()),
            days=preferences.get('days', 3)
        )
        serializer.save(user=self.request.user, route_data=ai_route)`
